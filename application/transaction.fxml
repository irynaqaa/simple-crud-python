<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Text text="Amount:"/>
        <TextField/>
        <Text text="Category:"/>
        <ComboBox>
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Food"/>
                    <String fx:value="Transportation"/>
                    <String fx:value="Housing"/>
                    <String fx:value="Entertainment"/>
                </FXCollections>
            </items>
        </ComboBox>
        <Text text="Date:"/>
        <DatePicker/>
        <Text text="Description:"/>
        <TextField/>
        <Text text="Type:"/>
        <ToggleGroup fx:id="typeToggleGroup"/>
        <RadioButton selected="true" text="Income" toggleGroup="$typeToggleGroup"/>
        <RadioButton text="Expense" toggleGroup="$typeToggleGroup"/>
        <Button mnemonicParsing="false" text="Submit"/>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>
