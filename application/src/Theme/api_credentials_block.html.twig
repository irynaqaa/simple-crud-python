{#
 * Template for the API Credentials Block.
 *
 * This template displays user data retrieved from the API.
 *
 * @var array $user_data
 *   The user data array containing username, email, and description.
 *}
<div class="api-credentials-block">
    {% if user_data.error is defined %}
        <div class="error-message">{{ user_data.error }}</div>
    {% else %}
        <div class="user-data">
            <h3>User Information</h3>
            <p><strong>Username:</strong> {{ user_data.username }}</p>
            <p><strong>Email:</strong> {{ user_data.email }}</p>
            <p><strong>Description:</strong> {{ user_data.description }}</p>
        </div>
    {% endif %}
</div>
